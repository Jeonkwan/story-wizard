{
  "name": "storyteller-studio",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "bash -c 'trap \"kill 0\" INT TERM EXIT; tsx watch --env-file-if-exists=.env server/index.ts & vite; wait'",
    "build": "tsc -p tsconfig.server.json && vite build",
    "start": "node --env-file-if-exists=.env dist/server/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:live": "tsx --env-file-if-exists=.env scripts/smokePhase3Live.ts && tsx --env-file-if-exists=.env scripts/smokePhase4Live.ts",
    "test:e2e": "npm run seed && npm run build && playwright test",
    "seed": "tsx scripts/seedLocalData.ts",
    "tunnel": "bash scripts/tunnel.sh",
    "migrate:gcs": "tsx scripts/migrateToGcs.ts",
    "migrate:m4a": "tsx --env-file-if-exists=.env scripts/migrateWavToM4a.ts"
  },
  "dependencies": {
    "@google-cloud/storage": "^7.15.2",
    "@google/genai": "^2.24.0",
    "cookie-parser": "^1.4.7",
    "express": "^4.21.2",
    "google-auth-library": "^9.15.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@types/supertest": "^6.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^26.0.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vite": "^6.1.1",
    "vitest": "^3.0.6"
  }
}
